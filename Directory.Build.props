<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Authors>Yehor Hrabovskyi</Authors>
    <Copyright>Yehor Hrabovskyi</Copyright>
    <PackageLicenseExpression>FSL-1.1-ALv2</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Egoushka/levelset</RepositoryUrl>
  </PropertyGroup>
</Project>
